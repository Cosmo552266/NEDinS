import pandas as pd
import vectorbt as vbt

IN_SAMPLE_END = pd.Timestamp("2022-12-31", tz="UTC")
DEFAULT_FEE = 0.0005          # 5 bps taker
DEFAULT_SLIPPAGE = 0.0005     # 5 bps
INIT_CASH = 100_000.0


