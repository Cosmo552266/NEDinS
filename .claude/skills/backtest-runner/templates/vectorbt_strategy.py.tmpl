def generate_signals(
    df: pd.DataFrame, p: {{CLASS_NAME}}Params
) -> tuple[pd.Series, pd.Series]:
    """Returns (entries, exits) boolean Series aligned to df.index."""
    ind = compute_indicator(df, p)
    {{SIGNAL_BODY}}
    return entries, exits


def run_backtest(
    df: pd.DataFrame,
    p: {{CLASS_NAME}}Params,
    *,
    in_sample_only: bool = True,
    fee: float = DEFAULT_FEE,
    slippage: float = DEFAULT_SLIPPAGE,
) -> vbt.Portfolio:
    if in_sample_only:
        assert df.index.max() <= IN_SAMPLE_END, (
            f"OOS leakage: df ends {df.index.max()} > IN_SAMPLE_END={IN_SAMPLE_END}. "
            "Set in_sample_only=False ONLY from statistical-validator skill."
        )
    entries, exits = generate_signals(df, p)
    pf = vbt.Portfolio.from_signals(
        close=df["close"],
        entries=entries,
        exits=exits,
        init_cash=INIT_CASH,
        fees=fee,
        slippage=slippage,
        freq=pd.infer_freq(df.index) or "1h",
    )
    # perp funding (optional)
    if "funding_rate" in df.columns:
        position = pf.position_mask()  # bool: in position
        funding_cost = (position * df["funding_rate"]).fillna(0)
        # subtract funding from returns externally — vbt doesn't natively support
        pf._funding_drag = funding_cost.sum() * INIT_CASH  # bookkeeping
    return pf


def metrics(pf: vbt.Portfolio) -> dict:
    stats = pf.stats()
    return {
        "total_return": float(stats["Total Return [%]"] / 100),
        "cagr": float(((1 + stats["Total Return [%]"] / 100) ** (
            365 / max((pf.wrapper.index.max() - pf.wrapper.index.min()).days, 1)
        )) - 1),
        "sharpe": float(stats["Sharpe Ratio"]),
        "sortino": float(stats["Sortino Ratio"]),
        "calmar": float(stats["Calmar Ratio"]),
        "max_dd": float(stats["Max Drawdown [%]"] / 100),
        "win_rate": float(stats.get("Win Rate [%]", np.nan) / 100),
        "profit_factor": float(stats.get("Profit Factor", np.nan)),
        "trade_count": int(stats["Total Trades"]),
        "skew": float(pf.returns().skew()),
        "kurtosis": float(pf.returns().kurtosis()),
    }


# ---------- Phase 5 helpers ----------

def param_sensitivity(
    df: pd.DataFrame, base: {{CLASS_NAME}}Params, grid: dict[str, list]
) -> pd.DataFrame:
    """grid = {'param_name': [v1, v2, ...]}. Returns long-form Sharpe table."""
    from itertools import product
    keys = list(grid)
    rows = []
    for combo in product(*(grid[k] for k in keys)):
        p = type(base)(**{**base.__dict__, **dict(zip(keys, combo))})
        pf = run_backtest(df, p)
        row = dict(zip(keys, combo)) | {"sharpe": metrics(pf)["sharpe"]}
        rows.append(row)
    return pd.DataFrame(rows)


def walk_forward(
    df: pd.DataFrame, p: {{CLASS_NAME}}Params, *,
    train_years: int = 5, test_months: int = 6, n_windows: int = 8,
) -> list[dict]:
    """Roll a (train, test) window. Train Sharpe is computed for completeness
    but param is locked to spec default — Phase 5 is NOT optimization."""
    results = []
    start = df.index.min()
    step = pd.DateOffset(months=test_months)
    for i in range(n_windows):
        train_start = start + step * i
        train_end = train_start + pd.DateOffset(years=train_years)
        test_end = train_end + step
        if test_end > df.index.max():
            break
        train = df.loc[train_start:train_end]
        test = df.loc[train_end:test_end]
        if len(test) < 30:
            continue
        results.append({
            "window": i,
            "train_period": (str(train_start.date()), str(train_end.date())),
            "test_period": (str(train_end.date()), str(test_end.date())),
            "train_sharpe": metrics(run_backtest(train, p))["sharpe"],
            "test_sharpe": metrics(run_backtest(test, p))["sharpe"],
        })
    return results
