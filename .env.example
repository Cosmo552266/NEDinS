# Gemini (text / Imagen / Veo / Chirp TTS)
GEMINI_API_KEY=

# Printify
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# YouTube Data API v3 (OAuth client + stored refresh token)
YOUTUBE_CLIENT_ID=
